NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://saas:saas@localhost:5432/saas_dev
JWT_SECRET=change_me_to_a_long_random_string
# Saltos de proxy de confianza delante del backend (0 = ninguno). Con 0 se ignora X-Forwarded-For.
# Detrás de nginx (Docker Compose) vale 1; con acceso directo, déjalo en 0.
TRUST_PROXY=0
# URL pública del frontend: base de los enlaces de activación de trabajadores (https:// en producción).
APP_URL=http://localhost:5173
# Asistente de IA (spec 011). Opcional: sin clave, /assistant/* responde 503 y el resto de la app funciona.
# Las claves son secretos: van solo en tu .env local (ignorado por git) o en el gestor de secretos del despliegue. Nunca en el repo.
# Proveedor: anthropic (por defecto) u openai (cualquier API compatible con chat/completions: Gemini, Groq, OpenRouter, Ollama).
ASSISTANT_PROVIDER=anthropic
# Con anthropic: clave de Anthropic; el modelo por defecto es claude-sonnet-5-5.
ANTHROPIC_API_KEY=
# Con openai, el modelo es obligatorio (p. ej. llama3.2 en Ollama) y también ASSISTANT_BASE_URL
# (p. ej. http://localhost:11434/v1 para Ollama local). ASSISTANT_API_KEY es opcional: Ollama no la pide.
ASSISTANT_MODEL=claude-sonnet-5-5
ASSISTANT_BASE_URL=
ASSISTANT_API_KEY=
