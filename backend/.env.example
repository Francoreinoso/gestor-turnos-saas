NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://saas:saas@localhost:5432/saas_dev
JWT_SECRET=change_me_to_a_long_random_string
# Saltos de proxy de confianza delante del backend (0 = ninguno). Con 0 se ignora X-Forwarded-For.
# Detrás de nginx (Docker Compose) vale 1; con acceso directo, déjalo en 0.
TRUST_PROXY=0
# URL pública del frontend: base de los enlaces de activación de trabajadores (https:// en producción).
APP_URL=http://localhost:5173
# Asistente de IA (spec 011). Opcional: sin clave, /assistant/* responde 503 y el resto de la app funciona.
# La clave es un secreto: va solo en tu .env local (ignorado por git) o en el gestor de secretos del despliegue. Nunca en el repo.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
