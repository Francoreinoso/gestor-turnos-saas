# Entorno de desarrollo para `docker compose up`: funciona tal cual al copiarlo a `.env`.
# Sin secretos reales.

# Base de datos (DATABASE_URL se arma en docker-compose.yml a partir de estas tres).
POSTGRES_DB=saas_dev
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas

# Firma de los JWT. CAMBIAR por una cadena larga y aleatoria fuera de desarrollo.
JWT_SECRET=dev-only-change-me-outside-development

# URL pública del frontend: base de los enlaces de activación de trabajadores (https:// en producción).
APP_URL=http://localhost:5173

# true: al levantar, siembra la cuenta demo si todavía no existe.
SEED_DEMO=true

# Zona horaria de los contenedores. Los horarios usan la hora local del servidor:
# conviene que navegador y servidor compartan zona.
TZ=America/Santiago

# Puertos publicados en la máquina anfitriona.
DB_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Asistente de IA (spec 011). Opcional: sin clave el asistente queda deshabilitado.
# Pega tu clave solo en tu .env local (ignorado por git); nunca la subas al repositorio.
# Proveedor: anthropic (por defecto) u openai (API compatible con chat/completions: Gemini, Groq, OpenRouter, Ollama).
ASSISTANT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Con openai, ASSISTANT_MODEL y ASSISTANT_BASE_URL son obligatorios; ASSISTANT_API_KEY es opcional (Ollama no la pide).
# Ollama corriendo en tu máquina se alcanza desde el contenedor en http://host.docker.internal:11434/v1
ASSISTANT_MODEL=claude-sonnet-5-5
ASSISTANT_BASE_URL=
ASSISTANT_API_KEY=
